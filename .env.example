# Copy to .env.local and fill in. Never commit real values.

# Resend API key (https://resend.com/api-keys). Server-only.
RESEND_API_KEY=

# Where inquiries are delivered. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=

# Sender shown on the notification email. Must be a domain verified in Resend;
# "onboarding@resend.dev" works for testing (delivers only to your Resend account email).
CONTACT_FROM_EMAIL="Nat. Website <onboarding@resend.dev>"

# Public site URL (used for metadata / absolute links). Exposed to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
